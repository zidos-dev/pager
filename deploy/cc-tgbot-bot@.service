[Unit]
Description=cc-tgbot: group assistant bot %i (responder role)
After=network-online.target
Wants=network-online.target

[Service]
# One instance per bot: %i is the slug of ~/.config/cc-tgbot/bots/<slug>/ (the registry that `cc_tgbot.py bots` writes).
Environment=CC_TGBOT_ENV=%h/.config/cc-tgbot/bots/%i/env
ExecStart=/usr/bin/python3 -u %h/cc-tgbot/cc_tgbot.py
Restart=always
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
