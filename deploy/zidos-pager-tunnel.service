[Unit]
Description=Zidos Pager: named Cloudflare tunnel for the mini-app / PWA
After=network-online.target
Wants=network-online.target

[Service]
# Needs ~/.cloudflared/zidos-pager.yml (see deploy/zidos-pager.yml.example); %h is your home directory.
ExecStart=/usr/bin/env cloudflared tunnel --no-autoupdate --config %h/.cloudflared/zidos-pager.yml run
Restart=always
RestartSec=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
