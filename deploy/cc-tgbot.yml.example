# Named Cloudflare tunnel for cc-tgbot (copy to ~/.cloudflared/cc-tgbot.yml and fill in the placeholders).
#
#   cloudflared tunnel login
#   cloudflared tunnel create cc-tgbot             # prints <TUNNEL_UUID>, writes ~/.cloudflared/<TUNNEL_UUID>.json
#   cloudflared tunnel route dns cc-tgbot cc.example.com
#
# Then set CC_WEBAPP_URL=https://cc.example.com in ~/.config/cc-tgbot/env.
tunnel: <TUNNEL_UUID>
credentials-file: /home/<USER>/.cloudflared/<TUNNEL_UUID>.json
ingress:
  - hostname: cc.example.com
    service: http://127.0.0.1:18795   # CC_WEBAPP_PORT
  - service: http_status:404
