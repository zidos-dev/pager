[Unit]
Description=Zidos Pager: SDK runner of the group assistant bot %i
After=network-online.target
Wants=network-online.target

[Service]
# The runner reads only its own sdk.env (never the bot's env: that one holds the Telegram token).
EnvironmentFile=-%h/.config/zidos-pager/bots/%i/sdk.env
ExecStart=%h/zidos-pager/.venv-sdk/bin/python -u %h/zidos-pager/sdk_runner.py serve
Restart=on-failure
RestartSec=5
KillMode=control-group
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
