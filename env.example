# cc-tgbot configuration. Copy to ~/.config/cc-tgbot/env and run: chmod 600 ~/.config/cc-tgbot/env
# Lines are KEY=VALUE; "#" starts a comment. Real environment variables are used when a key is missing here.

# ---- required ---------------------------------------------------------------------------------------------
# Bot token from @BotFather.
TG_BOT_TOKEN=
# Telegram user ids (comma-separated) that may use the bot. Anyone listed can run commands on this machine
# (sessions run with bypassPermissions) — keep the list to people you fully trust. The bot refuses to start without it.
TG_ALLOWED_USERS=

# ---- general ----------------------------------------------------------------------------------------------
# Interface language: en (default) or ru.
#CC_LANG=en
# Folder where new sessions start by default (default: your home directory).
#CC_DEFAULT_CWD=
# Path to the claude binary (default: found on PATH, else ~/.local/bin/claude).
#CC_CLAUDE_BIN=
# Use Claude Code: auto (default: when the binary is found) or off. With no `claude` binary (or off) the bot runs in
# SDK-only mode: it lists, starts and controls only SDK-runner sessions (see below and the README), and hides
# subscription quota, names and tmux screens.
#CC_CLAUDE=auto
# Where Claude Code keeps background-session state (default: ~/.claude/jobs).
#CC_JOBS_DIR=
# Bot state file (default: ~/.local/state/cc-tgbot/state.json). Another env file path: CC_TGBOT_ENV.
#CC_TGBOT_STATE=
#CC_TGBOT_ENV=
# Hours without activity after which the topic of a finished (done/failed) session is deleted (default: 24).
#CC_TOPIC_TTL_HOURS=24
# Optional quota file written by a Claude Code statusline hook:
# {"updated_at": epoch, "five_hour": {"used_percentage": 59, "resets_at": epoch}, "seven_day": {"used_percentage": 43}}
#CC_RATE_FILE=
# Folders (colon-separated) too generic to group sessions into a handoff chain by folder (default: none;
# your home, /tmp and /var/tmp are always generic).
#CC_CHAIN_GENERIC_DIRS=
# Telegram API base URL (default: https://api.telegram.org; useful for tests or a local Bot API server).
#TG_API_BASE=

# ---- mini-app / PWA ---------------------------------------------------------------------------------------
# Public https address of the mini-app (a tunnel or reverse proxy in front of 127.0.0.1:CC_WEBAPP_PORT).
# Without it the bot works in Telegram only; /pwa needs it.
#CC_WEBAPP_URL=https://cc.example.com
# Port of the built-in HTTP server (listens on 127.0.0.1 only; default 18795).
#CC_WEBAPP_PORT=18795
# Quick-tunnel mode: the file deploy/cc-tgbot-tunnel.sh writes the trycloudflare.com address to
# (default: ~/.local/state/cc-tgbot/tunnel-url). CC_WEBAPP_URL has priority over it.
#CC_TUNNEL_FILE=
# Static files of the mini-app (default: assets/webapp next to cc_tgbot.py).
#CC_WEBAPP_STATIC=
# Local development only: with CC_WEBAPP_DEV=1 requests from 127.0.0.1 carrying "X-Dev: 1" skip authentication.
# NEVER enable this on a machine where other users or processes you do not trust can reach the port.
#CC_WEBAPP_DEV=0

# ---- Web Push (optional; needs the "cryptography" Python package) ------------------------------------------
# Contact for VAPID, "mailto:you@example.com" or an https URL. Push notifications are disabled without it.
#CC_VAPID_SUB=mailto:you@example.com
# VAPID private key (created on first use, mode 0600; default: ~/.config/cc-tgbot/vapid.pem).
#CC_VAPID_FILE=

# ---- files ------------------------------------------------------------------------------------------------
# Queue directory for `cc-send` requests (default: ~/.local/state/cc-tgbot/outbox).
#CC_OUTBOX=

# JSONL queue written by the StopFailure hook (rate_limit / billing_error stops); the bot sends a notice per new line
# (default: ~/.local/state/claude-stopfailure/queue.jsonl).
#CC_STOPFAIL_QUEUE=

# ---- herdr (optional second backend: agents of herdr panes — codex, gemini, claude, … — next to Claude Code sessions) -----
# auto (default): on when the herdr socket exists; off: never touch herdr.
#CC_HERDR=auto
# Socket of the herdr server. Default: ~/.config/herdr/herdr.sock, or the socket of the named session below.
#CC_HERDR_SOCKET=
# Name of a herdr session (socket ~/.config/herdr/sessions/<name>/herdr.sock). Ignored when CC_HERDR_SOCKET is set.
#CC_HERDR_SESSION=

# ---- SDK runner (sdk_runner.py, separate process with its own virtualenv; see docs/sdk-protocol.md) --------
# Two files, on purpose. The runner reads ONLY ~/.config/cc-tgbot/sdk.env (loaded by deploy/cc-tgbot-sdk.service):
# everything in the runner's environment reaches the agent's tools, so never put the bot's env (it holds the
# Telegram token) there. The runner also drops TG_* and CC_TGBOT_* variables at start, as a safety net.
#
# --- for the BOT's env file (this file) ---
# Use the SDK runner: auto (default: when the runner socket answers) or off.
#CC_SDK=auto
# Unix socket of the runner (default: ~/.local/state/cc-tgbot/sdk.sock, mode 0600). Must be the same in both files.
#CC_SDK_SOCKET=

# ---- group assistant (answers in a group chat from a folder; needs the SDK runner or Codex) -------------------
# Group chat id (-100...). Empty = the assistant is off.
#CC_RESPONDER_CHAT=
# Folder the bot answers from: a plain folder or a git clone. Keep secrets out of it.
#CC_RESPONDER_CWD=
# How the bot calls itself in the group.
#CC_RESPONDER_NAME=
# Optional file with the role, tone and rules.
#CC_RESPONDER_BRIEF=
# Engine for the group: the SDK runner (default) or codex (run `codex login` first; read-only, trusted groups only).
#CC_RESPONDER_ENGINE=
# Codex model (optional, only with CC_RESPONDER_ENGINE=codex).
#CC_CODEX_MODEL=
#
# --- for the RUNNER's file ~/.config/cc-tgbot/sdk.env (chmod 600) ---
#CC_SDK_SOCKET=
# Runner state file (default: ~/.local/state/cc-tgbot/sdk.json). Never contains the API key.
#CC_SDK_STATE=
# File with NAME=value lines holding the API key (default: ~/.config/cc-tgbot/anthropic-api.env). Read by the runner
# when a session starts or resumes; the key goes only into that session's options, never into logs or state.
#CC_SDK_KEY_FILE=
# Name of the variable in that file (default: ANTHROPIC_API_KEY).
#CC_SDK_KEY_VAR=
# Default model and per-session budget in USD for sessions started without their own values (sonnet, 1.00; 0 = no limit).
#CC_SDK_MODEL=sonnet
#CC_SDK_BUDGET=1.00
# Another provider (any Anthropic-compatible address; see docs/manual-install.md). Example for DeepSeek:
#CC_SDK_BASE_URL=https://api.deepseek.com/anthropic
#CC_SDK_MODEL=deepseek-flash
#CC_SDK_KEY_VAR=DEEPSEEK_API_KEY
# Model for change requests (default: CC_SDK_MODEL) and steps per answer. With CC_SDK_BASE_URL the USD budget is off:
# the SDK knows only Claude prices.
#CC_SDK_STRONG_MODEL=
#CC_SDK_MAX_TURNS=30
# A site the chat sandbox may reach without asking (default: none).
#CC_CHAT_SITE=

# ---- voice input in the bot (needs the speech-to-text runner below) ----------------------------------------
# auto = voice messages and the mini-app microphone work when the runner socket exists; off = never touch it.
#CC_STT=auto
# Unix socket of the runner: must be the same path the runner listens on (default: ~/.local/state/cc-tgbot/stt.sock).
#CC_STT_SOCKET=
# Language hint for recognition (ru, en, ...). Default: the bot language (CC_LANG).
#CC_STT_LANG=

# ---- speech-to-text runner (stt_runner.py) ---------------------------------------------------------------
# These variables go into ~/.config/cc-tgbot/stt.env (chmod 600), read by deploy/cc-tgbot-stt.service.
# Do NOT put them, and above all the cloud API keys, into the bot's env file.
# Unix socket of the runner (default: ~/.local/state/cc-tgbot/stt.sock, mode 0600).
#CC_STT_SOCKET=
# Engines in the order they are tried; the next one is used on error or timeout: local, groq, openai (default: local).
#CC_STT_ENGINES=local
# Local faster-whisper model: tiny, base, small (default), large-v3, large-v3-turbo, or auto
# (auto = large-v3-turbo with at least 8 cores and 8 GB RAM, otherwise small). A model that is not cached
# is downloaded on first use (large-v3-turbo: about 1.6 GB); HF_HUB_OFFLINE=1 forbids downloads.
#CC_STT_MODEL=small
#HF_HUB_OFFLINE=1
# CPU threads of the local model (default: min(16, cores)).
#CC_STT_THREADS=
# Minutes of inactivity after which the local model is unloaded from memory (default: 10).
#CC_STT_IDLE=10
# Seconds one engine may take before the next one is tried (default: 60). A busy machine may need more.
#CC_STT_TIMEOUT=60
# Longest accepted audio in seconds (default: 300).
#CC_STT_MAX_SECONDS=300
# Files with the cloud API key: NAME=value or just the value. Read at each call, never logged or returned.
#CC_STT_GROQ_KEY_FILE=
#CC_STT_OPENAI_KEY_FILE=

# ---- extra group bots (each one is its own install in ~/.config/cc-tgbot/bots/<bot>/, made by `cc_tgbot.py bots`) --
# A bot's own env file carries CC_ROLE=responder: that process only answers in its group and sends 🔐 to the owner
# (no mini-app, no Claude Code sessions). Do not set CC_ROLE in this file.
